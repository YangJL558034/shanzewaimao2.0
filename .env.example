DATABASE_URL="file:./dev.db"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
APP_SECRET="replace-with-at-least-32-random-characters"
CAPTCHA_SECRET="replace-with-a-separate-random-captcha-secret"
DEFAULT_ADMIN_EMAIL="admin@enercore.com"
DEFAULT_ADMIN_PASSWORD="ChangeMe123!"

# SMTP：留空时邮件仍会先入库，并保持 pending 状态等待重试
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="ENERCORE Website <website@enercore.com>"
INQUIRY_NOTIFY_TO="sales@enercore.com"
EMAIL_CRON_SECRET="replace-with-a-random-worker-secret"

# 上传与限流
MAX_UPLOAD_MB="10"
MAX_VIDEO_UPLOAD_MB="100"
RATE_LIMIT_WINDOW_SECONDS="60"
RATE_LIMIT_MAX_REQUESTS="8"

# 访问统计地区识别：部署平台未提供国家/城市请求头时，使用 ipwho.is 查询并缓存 30 天
GEOIP_LOOKUP_ENABLED="true"
