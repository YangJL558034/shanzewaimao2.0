DATABASE_URL="file:./dev.db"
NEXT_PUBLIC_SITE_URL="https://shanzesz.com"
# 正式部署必须改为公网 HTTPS 域名；订阅邮件中的查看详情和取消订阅按钮会使用此地址
# Google Search Console HTML 标签验证值（只填写 content 中的令牌）
GOOGLE_SITE_VERIFICATION=""
# GA4 衡量 ID；也可在后台 Google 与 SEO 配置保存。仅生产环境且访客同意后加载。
NEXT_PUBLIC_GA4_MEASUREMENT_ID=""
APP_SECRET="replace-with-at-least-32-random-characters"
CAPTCHA_SECRET="replace-with-a-separate-random-captcha-secret"
# 留空时自动读取反向代理的 X-Forwarded-Proto；特殊部署可设为 true 或 false
COOKIE_SECURE=""
DEFAULT_ADMIN_EMAIL="admin@enercore.com"
DEFAULT_ADMIN_PASSWORD="ChangeMe123!"

# SMTP：留空时邮件仍会先入库，并保持 pending 状态等待重试
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Shanze New Energy Technology Website <website@enercore.com>"
INQUIRY_NOTIFY_TO="sales@enercore.com"
EMAIL_CRON_SECRET="replace-with-a-random-worker-secret"

# Unified customer center: leave blank until each channel is connected.
# Crisp website ID enables the public chat widget; use a strong secret to validate Crisp webhooks.
NEXT_PUBLIC_CRISP_WEBSITE_ID=""
CRISP_WEBHOOK_SECRET=""
CRISP_WEBSITE_ID=""
CRISP_IDENTIFIER=""
CRISP_KEY=""
# WhatsApp Cloud API webhook verification/signature values and public click-to-chat number.
NEXT_PUBLIC_WHATSAPP_NUMBER=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_GRAPH_API_VERSION=""
# LinkedIn / inbound-email providers should POST JSON to /api/webhooks/linkedin or /api/webhooks/email.
NEXT_PUBLIC_LINKEDIN_URL=""
LINKEDIN_WEBHOOK_SECRET=""
INBOUND_EMAIL_WEBHOOK_SECRET=""

# 上传与限流
MAX_UPLOAD_MB="10"
MAX_VIDEO_UPLOAD_MB="100"
RATE_LIMIT_WINDOW_SECONDS="60"
RATE_LIMIT_MAX_REQUESTS="8"

# 访问统计地区识别：部署平台未提供国家/城市请求头时，使用 ipwho.is 查询并缓存 30 天
GEOIP_LOOKUP_ENABLED="true"

# 安全中心：连接本机或私有网络中的 ClamAV；不要向公网暴露 clamd 端口。
CLAMAV_HOST="127.0.0.1"
CLAMAV_PORT="3310"
# 如使用本地 clamscan，可设置完整可执行文件路径；留空则检测 PATH。
CLAMAV_BINARY=""
ANTIVIRUS_ENGINE="auto"
ANTIVIRUS_TIMEOUT_MS="15000"
ANTIVIRUS_MAX_BYTES="41943040"
# 未配置引擎时 false 为监测模式；正式启用 true 后，未通过扫描的上传会被阻止。
ANTIVIRUS_REQUIRE_CLEAN="false"
SECURITY_SCAN_MAX_FILES="1000"
