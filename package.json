{
  "name": "enercore-b2b-cms",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "^22.16.0 || >=24.0.0"
  },
  "scripts": {
    "postinstall": "node scripts/patch-build-dependencies.mjs && prisma generate",
    "dev": "next dev --hostname 0.0.0.0",
    "build": "node scripts/patch-build-dependencies.mjs --check && prisma generate && next build",
    "start": "node scripts/import-content-release.mjs --apply && next start --hostname 0.0.0.0",
    "lint": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "storage:prepare": "node scripts/prepare-storage.mjs",
    "db:deploy": "npm run storage:prepare && prisma migrate deploy && node scripts/import-content-release.mjs --apply",
    "db:history:check": "node scripts/reconcile-migration-history.mjs --dry-run",
    "db:history:test": "node scripts/check-migration-history.mjs",
    "backup:test": "node --conditions=react-server --import tsx scripts/check-backup-storage.mjs",
    "db:seed": "tsx prisma/seed.ts && node scripts/import-content-release.mjs --apply",
    "content:export": "node scripts/export-content-release.mjs",
    "content:preview": "node scripts/import-content-release.mjs",
    "content:import": "node scripts/import-content-release.mjs --apply",
    "content:test": "node scripts/check-content-release.mjs",
    "seo:seed": "tsx scripts/seed-seo-content.ts",
    "seo:audit": "node scripts/audit-seo.mjs",
    "seo:test": "node scripts/check-seo-helpers.mjs",
    "seo:browser": "node scripts/check-ga4-browser.mjs",
    "images:optimize": "tsx scripts/optimize-site-images.ts",
    "images:test": "tsx scripts/check-image-optimization.ts && tsx scripts/check-image-seo-migration.ts && node --conditions=react-server --import tsx scripts/check-image-upload.ts && node scripts/check-image-sitemap.mjs",
    "brand:rename": "tsx scripts/rename-shanze-brand.ts",
    "company:import": "tsx scripts/import-company-profile.ts",
    "company:test": "node scripts/check-company-profile.mjs",
    "certificates:import": "tsx scripts/import-company-certificates.ts",
    "certificates:test": "node scripts/check-certificates.mjs",
    "certificates:migrate": "tsx scripts/apply-certificate-category-migration.ts",
    "certificates:browser": "node scripts/check-admin-ui.mjs --certificates",
    "support:browser": "node scripts/check-admin-ui.mjs --support",
    "db:studio": "prisma studio",
    "email:worker": "tsx scripts/email-worker.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.12.0",
    "bcryptjs": "3.0.2",
    "clsx": "2.1.1",
    "lucide-react": "0.468.0",
    "next": "16.3.8",
    "nodemailer": "10.1.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-is": "19.2.0",
    "recharts": "3.10.1",
    "sharp": "0.35.5",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.17.2",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "autoprefixer": "10.4.21",
    "postcss": "8.5.26",
    "prisma": "6.12.0",
    "tailwindcss": "3.4.19",
    "tsx": "4.20.4",
    "typescript": "5.9.2"
  },
  "overrides": {
    "source-map-js": "1.2.2",
    "postcss-selector-parser": "7.1.6"
  }
}
